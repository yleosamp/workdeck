# Copie este arquivo para .env e altere os dados abaixo.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=workdeck
MYSQL_PASSWORD=troque-esta-senha
MYSQL_DATABASE=workdeck

# Gere uma chave longa e aleatória antes de publicar.
JWT_SECRET=troque-por-uma-chave-aleatoria-de-pelo-menos-64-caracteres

API_HOST=127.0.0.1
API_PORT=8787
PUBLIC_API_URL=http://127.0.0.1:8787
CLIENT_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost

# Atualizações: use a pasta local na VPS ou a URL do latest.json criado pelo GitHub Actions.
RELEASES_DIR=./releases
UPDATE_MANIFEST_URL=

# Calls: deixe vazio para usar somente STUN/P2P. Em produção, configure o coturn.
TURN_URLS=
TURN_SECRET=
